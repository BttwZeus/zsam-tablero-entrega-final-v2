# Copia este archivo como .env y llena tus valores REALES.
# El archivo .env esta en .gitignore: nunca debe llegar al repositorio.

# Para desarrollo local con docker-compose deja DB_HOST=db (usa el Postgres del compose).
# Para produccion, cambialo al endpoint de tu RDS real.
DB_HOST=db
DB_PORT=5432
DB_NAME=tablero
DB_USER=tablero
DB_PASSWORD=tablero

AWS_REGION=us-east-1
S3_BUCKET=tu-bucket-de-adjuntos
# En AWS Academy Learner Lab copia estas 3 credenciales temporales desde "AWS Details".
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_SESSION_TOKEN=

RABBITMQ_HOST=rabbitmq
RABBITMQ_USER=guest
RABBITMQ_PASSWORD=guest
REMINDER_QUEUE=reminders
